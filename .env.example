# ==============================================================================
# AT&T Price Monitor — Variables de entorno (Desarrollo y Etapas futuras)
# Todas las variables de Telegram y Cloud Run son OPCIONALES en desarrollo.
# ==============================================================================

# APP_URL: URL pública de esta app web (inyectada automáticamente en AI Studio / Cloud Run Service)
APP_URL="http://localhost:3000"

# PORT: Puerto del servidor Node.js + Express (por defecto 3000)
PORT="3000"

# SCRAPER_LIVE_ENABLED: Predeterminado "false".
# Se evalúa estrictamente como process.env.SCRAPER_LIVE_ENABLED === 'true'.
# Mantener en "false" hasta completar Etapa 2 (validación manual de selectores y cumplimiento).
SCRAPER_LIVE_ENABLED="false"

# ATT_SELECTORS_FILE: Ruta opcional a un archivo JSON con selectores validados por grupo
# (ver plantilla en worker/config/selectors.example.json). Si está vacío se usa worker/config/selectors.json
# si existe, o UNCONFIGURED_ATT_SELECTORS de forma segura.
ATT_SELECTORS_FILE=""

# ------------------------------------------------------------------------------
# Telegram (OPCIONAL en desarrollo)
# Si TELEGRAM_BOT_TOKEN no está definido, el envío real queda desactivado
# y la app mantiene intacta la vista previa visual simulada.
# NUNCA exponer este token en el frontend (sin prefijo VITE_).
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT_ID=""

# ------------------------------------------------------------------------------
# Worker independiente en Cloud Run Jobs (OPCIONAL en desarrollo - Etapa 3)
# Un Cloud Run Job NO expone una URL HTTP pública: se invoca mediante
# Cloud Scheduler -> Cloud Run Admin API v2 autenticada (OAuth2 / IAM).
# ------------------------------------------------------------------------------
CLOUD_RUN_PROJECT_ID=""
CLOUD_RUN_REGION="us-central1"
CLOUD_RUN_JOB_NAME="att-price-monitor-worker"

# CLOUD_RUN_WORKER_URL: Opcional y reservado solo si en el futuro existiera un
# servicio HTTP auxiliar privado; NO se asume ni se requiere para Cloud Run Jobs.
CLOUD_RUN_WORKER_URL=""
